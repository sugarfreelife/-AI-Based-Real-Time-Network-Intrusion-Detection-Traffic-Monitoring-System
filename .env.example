# Copy to .env and set values for your local environment.
# Do not use development placeholders in a shared or production deployment.
# Leave empty for the local SQLite fallback, or set a PostgreSQL URL for a shared database.
DATABASE_URL=
JWT_SECRET_KEY=
JWT_ISSUER=nids-api
JWT_AUDIENCE=nids-client
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NIDS_LOG_LEVEL=INFO
