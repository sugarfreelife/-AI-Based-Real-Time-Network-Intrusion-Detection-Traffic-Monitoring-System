# Copy to .env and set values for your local environment.
# Do not use development placeholders in a shared or production deployment.
# Leave DATABASE_URL empty for the local SQLite fallback. Compose constructs its PostgreSQL URL from POSTGRES_* below.
DATABASE_URL=
# Used by Docker Compose; choose a hexadecimal password to keep the URL valid.
POSTGRES_DB=nids
POSTGRES_USER=nids
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
JWT_ISSUER=nids-api
JWT_AUDIENCE=nids-client
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NIDS_LOG_LEVEL=INFO
DASHBOARD_PORT=8080
PCAP_PATH=/captures/demo.pcap
# Optional trusted model path inside the monitor container, for example /models/nids-model.joblib
MODEL_PATH=
